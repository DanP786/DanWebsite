---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<BaseLayout title={d.title} description={d.tagline}>
  <article class="container project">
    <p class="eyebrow">
      {d.type === "flagship" ? "Case Study" : "Project"}
    </p>
    <h1>{d.title}</h1>
    <p class="tagline">{d.tagline}</p>

    {d.youtubeId ? (
      <div class="video">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${d.youtubeId}`}
          title={`${d.title}, video`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    ) : d.localVideo ? (
      <div class:list={["video", { portrait: d.videoAspect === "portrait" }]}>
        <video
          src={d.localVideo}
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
        ></video>
      </div>
    ) : d.hero ? (
      <div class="hero-img">
        <Image
          src={d.hero}
          alt={d.heroAlt ?? d.title}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 820px) 100vw, 820px"
        />
      </div>
    ) : null}

    <dl class="meta">
      <div><dt>Role</dt><dd>{d.role}</dd></div>
      {d.teamSize && (<div><dt>Team</dt><dd>{d.teamSize}</dd></div>)}
      <div><dt>Dates</dt><dd>{d.dates}</dd></div>
      {d.platforms.length > 0 && (
        <div><dt>Platforms</dt><dd>{d.platforms.join(" · ")}</dd></div>
      )}
      {d.tech && (<div><dt>Tech</dt><dd>{d.tech}</dd></div>)}
    </dl>

    <div class="prose">
      <Content />
    </div>

    {d.links.length > 0 && (
      <div class="links">
        <p class="eyebrow">Links</p>
        <ul>
          {d.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="back"><a href="/">← Back to all work</a></p>
  </article>
</BaseLayout>

<style>
  .project {
    padding-top: 3rem;
    max-width: 820px;
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--muted);
    margin-top: -0.25rem;
    margin-bottom: 2rem;
  }

  .video {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    margin-bottom: 2.5rem;
    background: var(--ink);
  }

  .video iframe,
  .video video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .video.portrait {
    padding-bottom: 0;
    height: auto;
    max-width: 360px;
    margin-inline: auto;
    background: transparent;
  }

  .video.portrait video {
    position: static;
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-img {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    margin-bottom: 2.5rem;
  }

  .hero-img :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: 0 0 3rem;
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta dt {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }

  .meta dd {
    margin: 0;
    font-weight: 500;
  }

  .prose :global(h2) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(h3) {
    margin-top: 1.75rem;
  }

  .prose :global(img) {
    border-radius: var(--radius-sm);
    margin: 1.25rem 0;
    box-shadow: var(--shadow-sm);
  }

  .prose :global(.image-row) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 1.25rem 0;
  }

  .prose :global(.image-row img) {
    margin: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 540px) {
    .prose :global(.image-row) {
      grid-template-columns: 1fr;
    }
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.25rem 1rem;
    margin: 1.5rem 0;
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(code) {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.92em;
  }

  .links {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .links ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .back {
    margin-top: 3.5rem;
    color: var(--muted);
  }
</style>
