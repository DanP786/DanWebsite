---
import { site } from "../site.config";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="footer-line muted">{site.role} · UK</p>
    </div>
    <ul class="footer-links">
      <li>
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </li>
      <li>
        <a href="/cv">CV</a>
      </li>
    </ul>
    <p class="footer-copy muted">© {year} Daniel Joseph Pearce</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-name {
    font-weight: 600;
    margin: 0;
  }

  .footer-line {
    margin: 0;
    font-size: 0.9rem;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    justify-content: center;
  }

  .footer-links a {
    color: var(--muted);
    font-weight: 500;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-copy {
    margin: 0;
    text-align: right;
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .footer-links {
      justify-content: flex-start;
    }
    .footer-copy {
      text-align: left;
    }
  }
</style>
